---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mecanografía · Practica tu velocidad',
  description = 'Juego web de mecanografía con 40 subniveles: de la fila guía (ASDF JKL;) a fragmentos de código real en HTML, JS, CSS y SQL. Progreso guardado en tu navegador.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      // Anti-FOUC: aplica el tema guardado antes del primer paint.
      // Debe ser código inline y autónomo (no puede importar src/lib/theme.ts),
      // pero comparte la misma clave/valores que ese módulo.
      (function () {
        const STORAGE_KEY = 'theme-preference';
        let theme = 'light';
        try {
          const stored = localStorage.getItem(STORAGE_KEY);
          if (stored === 'light' || stored === 'dark' || stored === 'mixed') theme = stored;
        } catch {
          // localStorage inaccesible (modo privado, etc.) — usamos el valor por defecto.
        }
        const root = document.documentElement;
        if (theme === 'dark') root.classList.add('dark');
        else if (theme === 'mixed') root.classList.add('theme-mixed');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body
    class="min-h-screen bg-stone-100 text-slate-700 antialiased transition-colors dark:bg-slate-900 dark:text-slate-100"
  >
    <slot />
  </body>
</html>
