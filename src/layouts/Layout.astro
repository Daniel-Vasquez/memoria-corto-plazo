---
import '@/styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Mecanografía · Practica tu velocidad' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-stone-100 text-slate-700 antialiased">
    <slot />
  </body>
</html>
