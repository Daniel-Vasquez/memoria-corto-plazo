---
import Layout from '@/layouts/Layout.astro';
import TypingGame from '@/components/TypingGame';
import ThemeToggle from '@/components/ThemeToggle';
---

<Layout>
  <header
    class="border-b border-transparent px-6 py-4 transition-colors dark:border-slate-800 dark:bg-slate-900 mixed:border-slate-800 mixed:bg-slate-900"
  >
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 sm:flex-row sm:justify-between">
      <div class="text-center sm:text-left">
        <h1 class="text-3xl font-bold text-slate-700 dark:text-slate-100 mixed:text-slate-100">Domina el teclado</h1>
        <p class="mt-1 text-slate-500 dark:text-slate-400 mixed:text-slate-400">
          40 subniveles, del ASDF a los fragmentos de código real.
        </p>
      </div>
      <ThemeToggle client:load />
    </div>
  </header>

  <TypingGame client:load />

  <footer
    class="mt-10 border-t border-transparent px-6 py-6 text-center text-sm text-slate-500 transition-colors dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400 mixed:border-slate-800 mixed:bg-slate-900 mixed:text-slate-400"
  >
    <p>Hecho para practicar mecanografía · tu progreso se guarda solo en este navegador.</p>
  </footer>
</Layout>
